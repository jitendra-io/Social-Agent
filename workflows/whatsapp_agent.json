          }
        ]
      ]
    },
    "Save Lead in MySQL": {
      "main": [
        [
          {
            "node": "Dispatch to Dev Bridge (:8050)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dispatch to Dev Bridge (:8050)": {
      "main": [
        [
          {
            "node": "Alert Executive on Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
