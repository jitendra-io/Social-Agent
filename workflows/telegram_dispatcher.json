{
  "name": "Telegram Executive Command Dispatcher",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "tg-trigger-1",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [160, 360],
      "webhookId": "tg-webhook-dispatcher"
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.message.from.id }}",
              "operation": "equal",
              "value2": "={{ $env.TELEGRAM_ADMIN_ID }}"
            }
          ]
        }
      },
      "id": "security-filter-1",
      "name": "Admin Security Gate",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [360, 360]
    },
    {
      "parameters": {
        "chatId": "={{ $json.message.chat.id }}",
        "text": "🛡️ *ACCESS DENIED*\nUnauthorized sender ID detected. Commands are restricted exclusively to the Executive Director.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "reject-msg-1",
      "name": "Reject Unauthorized",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [580, 560]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO executive_memory (memory_type, category, content, source, importance_score)\nVALUES (\n  'conversation',\n  'executive_log',\n  '{{ $json.message.text.replace(/'/g, \"''\") }}',\n  'telegram',\n  5\n);"
      },
      "id": "auto-save-memory",
      "name": "Auto-Log to Executive Memory",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
      "position": [580, 340]
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $('Telegram Trigger').item.json.message.text.split(' ')[0] }}",
                    "rightValue": "/status",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $('Telegram Trigger').item.json.message.text.split(' ')[0] }}",
                    "rightValue": "/post",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $('Telegram Trigger').item.json.message.text.split(' ')[0] }}",
                    "rightValue": "/buildsite",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $('Telegram Trigger').item.json.message.text.split(' ')[0] }}",
                    "rightValue": "/remember",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $('Telegram Trigger').item.json.message.text.split(' ')[0] }}",
                    "rightValue": "/recall",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "command-router-1",
      "name": "Command Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [800, 340]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT (SELECT COUNT(*) FROM posts) AS total_posts, (SELECT COUNT(*) FROM posts WHERE status='published') AS published_count, (SELECT COUNT(*) FROM executive_memory) AS memory_count;"
      },
      "id": "db-status-query",
      "name": "Query System Status",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
      "position": [1060, 60]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "=⚡ *NOVA OPERATIONS INTELLIGENCE REPORT*\n\n🟢 *Identity:* Nova (Executive Chief of Staff)\n🏢 *Agency:* SocialAgent OS\n🗄️ *MySQL 8.0 Memory:* Connected & Active\n🧠 *Memories Stored:* {{ $json.memory_count || 0 }} directives\n\n📊 *Total Content Tracked:* {{ $json.total_posts || 0 }}\n🚀 *Successfully Published:* {{ $json.published_count || 0 }}\n🌐 *Dev Bridge:* Online (:8050)\n🎥 *Media Engine:* Online (:8000)",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "tg-send-status",
      "name": "Send Status Response",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1280, 60]
    },
    {
      "parameters": {
        "workflowId": "social-pipeline-workflow",
        "options": {}
      },
      "id": "trigger-post-pipeline",
      "name": "Trigger Social Pipeline",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [1060, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8050/build-website",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"client_name\": \"{{ $('Telegram Trigger').item.json.message.text.replace('/buildsite', '').trim() || 'Client Project' }}\",\n  \"niche\": \"Enterprise Solutions\",\n  \"callback_url\": \"{{ $env.WEBHOOK_URL }}webhook/build-complete\"\n}",
        "options": {}
      },
      "id": "trigger-dev-bridge",
      "name": "Trigger Dev Bridge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1060, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "=🚀 *Autonomous Web Build Initiated!*\nTarget: *{{ $('Telegram Trigger').item.json.message.text.replace('/buildsite', '').trim() || 'Client Project' }}*\nScaffolding modern Vite + React workspace. Live link will be dispatched shortly.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "tg-confirm-build",
      "name": "Send Build Confirmation",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1280, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO executive_memory (memory_type, category, content, importance_score)\nVALUES (\n  'rule',\n  'executive_directive',\n  '{{ $('Telegram Trigger').item.json.message.text.replace('/remember', '').trim().replace(/'/g, \"''\") }}',\n  10\n);"
      },
      "id": "db-save-directive",
      "name": "Save Executive Directive",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
      "position": [1060, 420]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "=🧠 *DIRECTIVE LOCKED INTO PERMANENT MEMORY*\n\n\"{{ $('Telegram Trigger').item.json.message.text.replace('/remember', '').trim() }}\"\n\nI have permanently recorded this rule in the MySQL executive memory bank. All future content, code, and operational decisions will abide by this instruction.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "tg-confirm-remember",
      "name": "Confirm Memory Saved",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1280, 420]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT content, memory_type, created_at \nFROM executive_memory \nWHERE content LIKE '%{{ $('Telegram Trigger').item.json.message.text.replace('/recall', '').trim().replace(/'/g, \"''\") }}%'\nORDER BY importance_score DESC, created_at DESC \nLIMIT 5;"
      },
      "id": "db-recall-memories",
      "name": "Search Executive Memories",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
      "position": [1060, 540]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "=🔍 *RECALLED EXECUTIVE MEMORIES:*\n\n{{ $json.map((m, i) => `${i+1}. [${m.memory_type.toUpperCase()}] ${m.content} (${m.created_at})`).join('\\n\\n') || 'No specific memories found matching that query.' }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "tg-send-recalled-memories",
      "name": "Send Recalled Memories",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1280, 540]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT GROUP_CONCAT(content SEPARATOR '\n- ') AS memories FROM (SELECT content FROM executive_memory ORDER BY importance_score DESC, created_at DESC LIMIT 10) AS sub;"
      },
      "id": "db-get-top-memories",
      "name": "Fetch Top Memories for Context",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
      "position": [1060, 680]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent?key={{ $env.GEMINI_API_KEY }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: \"You are Nova, the Executive Chief of Staff for SocialAgent OS. You serve the Executive Director with absolute precision, high intelligence, and executive warmth. Memories & Strategic Context: \" + ($json.memories || \"No stored memories yet.\") + \". The Executive Director says: \" + JSON.stringify($('Telegram Trigger').item.json.message.text) + \". Respond warmly, professionally, and concisely in under 60 words as Nova.\" }] }] }) }}",
        "options": {
          "neverError": true
        }
      },
      "onError": "continueRegularOutput",
      "id": "gemini-conversational-nova",
      "name": "Gemini Identity & Memory Engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1280, 680]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{ $json.candidates?.[0]?.content?.parts?.[0]?.text || ('⚡ *Nova Online*\\n\\nDirective logged into executive memory:\\n> ' + $('Telegram Trigger').item.json.message.text + '\\n\\n*(Note: Google AI Studio is experiencing temporary high demand/cooldown; I am actively standing by for your commands like /status or /buildsite!)*') }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "tg-send-nova-reply",
      "name": "Send Nova Response",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1500, 680]
    }
  ],
