# =====================================================================
# AUTONOMOUS AI DIGITAL AGENCY & OPERATIONS OS - ENVIRONMENT CONFIGURATION
# =====================================================================
# Copy this file to .env before starting the system:
#   cp .env.example .env
# Fill in the appropriate credentials for each active service.
# =====================================================================

# ---------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MySQL 8.0)
# ---------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=agency_root_secure_password_replace_me
MYSQL_DATABASE=agency_db
MYSQL_USER=agency_user
MYSQL_PASSWORD=agency_user_password_replace_me
MYSQL_PORT=3306
MYSQL_HOST=database

# ---------------------------------------------------------------------
# 2. N8N ORCHESTRATOR CONFIGURATION
# ---------------------------------------------------------------------
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
# Public URL where webhooks will be received (use ngrok/cloudflared tunnel for live webhooks)
WEBHOOK_URL=http://localhost:5678/
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
GENERIC_TIMEZONE=UTC
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# ---------------------------------------------------------------------
# 3. EXECUTIVE COMMAND CENTER (TELEGRAM BOT)
# ---------------------------------------------------------------------
# Obtain via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Your personal Telegram User ID (obtain via @userinfobot). Messages from other users will be rejected!
TELEGRAM_ADMIN_ID=your_telegram_user_id_here

# ---------------------------------------------------------------------
# 4. ZERO-COST AI INTELLIGENCE (LLMs)
# ---------------------------------------------------------------------
# Google Gemini Free Tier (API key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
# Groq Cloud Free Tier for ultra-fast Llama 3.3 70B inference (https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
# Hugging Face User Access Token (Free tier from https://huggingface.co/settings/tokens)
HF_TOKEN=your_huggingface_token_here

# ---------------------------------------------------------------------
# 5. PYTHON MEDIA ENGINE MICROSERVICE
# ---------------------------------------------------------------------
MEDIA_ENGINE_HOST=media-engine
MEDIA_ENGINE_PORT=8000
SHARED_MEDIA_DIR=/app/output
DEFAULT_VOICE_MODEL=en-US-ChristopherNeural
# Fallback voice models: en-US-EricNeural, en-GB-SoniaNeural

# ---------------------------------------------------------------------
# 6. INBOUND CLIENT FUNNEL (WHATSAPP BUSINESS CLOUD API)
# ---------------------------------------------------------------------
# Obtain from Meta for Developers (https://developers.facebook.com/)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_VERIFY_TOKEN=custom_random_verification_token_here

# ---------------------------------------------------------------------
# 7. MULTI-PLATFORM SOCIAL PUBLISHING APIS
# ---------------------------------------------------------------------
# YouTube Data API v3 (Google Cloud Console OAuth 2.0 Credentials)
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here

# Meta Graph API (Instagram Reels & Facebook Pages)
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id_here

# X (Twitter) API v2 (Developer Portal: Elevated / Free v2 access)
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_SECRET=your_twitter_access_token_secret_here

# ---------------------------------------------------------------------
# 8. AUTONOMOUS DEV BRIDGE & DEPLOYMENT
# ---------------------------------------------------------------------
DEV_BRIDGE_PORT=8050
DEV_BRIDGE_HOST=localhost
# GitHub Personal Access Token with repo permissions
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_USERNAME=your_github_username_here
# Optional free cloud deployment triggers
VERCEL_TOKEN=your_vercel_token_here
RENDER_API_KEY=your_render_api_key_here
